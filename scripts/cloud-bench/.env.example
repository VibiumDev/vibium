# Cloud benchmark credentials — copy to .env and `source` it, or export
# directly. A provider activates when its vars are set.
#
# scripts/cloud-bench/results/ holds the raw timings.

# --- WebDriver BiDi native: vibium drives these fully ---

# Kernel (dashboard.onkernel.com/api-keys)
export KERNEL_API_KEY=

# --- Selenium grids: vibium mints the session itself (classic WebDriver) ---

# BrowserStack Automate (browserstack.com → Account & Profile → Summary)
export BROWSERSTACK_USERNAME=
export BROWSERSTACK_ACCESS_KEY=

# Sauce Labs (app.saucelabs.com/user-settings; credentials are per data center)
export SAUCE_USERNAME=
export SAUCE_ACCESS_KEY=
export SAUCE_REGION=us-west-1

# LambdaTest / TestMu (dashboard → Profile → Account Settings)
export LT_USERNAME=
export LT_ACCESS_KEY=

# TestingBot (testingbot.com → Account → key/secret)
export TESTINGBOT_KEY=
export TESTINGBOT_SECRET=

# --- CDP-only: bench times session mint/delete only, until the BiDi shim ---

# Browserbase (browserbase.com dashboard)
export BROWSERBASE_API_KEY=

# Browser-Use Cloud (cloud.browser-use.com/settings?tab=api-keys)
export BROWSER_USE_API_KEY=

# Hyperbrowser (app.hyperbrowser.ai)
export HYPERBROWSER_API_KEY=

# Cloudflare Browser Run (dash.cloudflare.com → API token with
# "Browser Rendering - Edit" permission)
export CLOUDFLARE_ACCOUNT_ID=
export CLOUDFLARE_API_TOKEN=

# Not benchable yet: AWS AgentCore Browser needs SigV4-signed WebSocket
# upgrades (AWS SDK work); Browserless has no REST session mint — the
# session is created on CDP ws connect, which vibium can't speak.

# --- DIY: any classic WebDriver endpoint reachable from this machine ---
# e.g. ssh -N -L 9515:127.0.0.1:9515 user@box   (DigitalOcean, AWS, exe.dev)
#      fly proxy 9515:9515 -a vibium-browsers   (Fly.io)
export DIY_TUNNEL_URL=

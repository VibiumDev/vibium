# Moved. The provider list now ships inside the binary so it lands in the
# right place with the right permissions:
#
#   vibium config init cloud      # writes ~/.config/vibium/cloud-browser.env (0600)
#   source ~/.config/vibium/cloud-browser.env
#   node scripts/cloud-bench/bench.js
#
# The template itself is config/cloud-browser.env in this repo.

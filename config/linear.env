# Vibium Linear settings — used by `vibium report linear` and `--report linear`.
#
# Optional. Task management is not required for run, check, or the browser.
# Vibium loads this file for empty Linear variables on each command.
# Nonempty process environment still wins. Command substitution is not
# expanded; use a plain value. Set VIBIUM_LOAD_LINEAR_ENV=0 to skip.
#
#   vibium setup tasks
#   vibium config init linear
#
# Keep the API key here rather than in chat, project source, or an agent prompt.
# This file is created 0600 (owner read/write only); leave it that way.

# Personal API key from Linear Settings → API.
# LINEAR_API_KEY is also accepted if this is empty.
export VIBIUM_LINEAR_API_KEY=

# Team key as shown on issues (ENG, RAV, …). Used when creating issues.
export VIBIUM_LINEAR_TEAM=

# Optional team UUID. Overrides the key lookup when set.
# export VIBIUM_LINEAR_TEAM_ID=

# Vibium AI settings — used by `vibium run` and `vibium check`.
#
# Vibium does NOT load this file automatically. Source it in the shell that
# runs vibium, and keep `export` on every line so the values reach the binary:
#
#   source ~/.config/vibium/ai.env
#   vibium ready ai
#
# Keep real keys here rather than in chat, project source, or an agent prompt.
# This file is created 0600 (owner read/write only); leave it that way.

# --- Provider ---------------------------------------------------------------
# One of: openai, anthropic, google, openai-compatible, local
export VIBIUM_AI_PROVIDER=openai

# A model your API account can actually access.
export VIBIUM_AI_MODEL=gpt-5.6-sol

# Reasoning effort for tool calls. Models differ; "none" suits some, not all.
export VIBIUM_AI_REASONING_EFFORT=none

# --- Credentials ------------------------------------------------------------
# Set the one matching your provider. Delete the rest.
#
# Left empty on purpose: `vibium ready ai` then reports the key as missing
# before it calls the provider. A placeholder string would pass that check and
# fail later as an authentication error, after a billable request.
export OPENAI_API_KEY=
# export ANTHROPIC_API_KEY=
# export GEMINI_API_KEY=

# --- Optional ---------------------------------------------------------------
# For openai-compatible or a local server (Ollama, vLLM, LM Studio):
# export VIBIUM_AI_BASE_URL=http://127.0.0.1:11434/v1
